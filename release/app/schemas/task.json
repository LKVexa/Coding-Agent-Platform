{
  "type": "object",
  "required": [
    "id",
    "path",
    "function",
    "parameters",
    "description",
    "public_examples"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"
    },
    "path": {
      "type": "string",
      "maxLength": 180,
      "pattern": "^[A-Za-z0-9_-]+(?:/[A-Za-z0-9_.-]+)*\\.py$"
    },
    "function": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "parameters": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      }
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 6000
    },
    "public_examples": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": [
          "args",
          "expected"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "args": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": [
                "number",
                "boolean"
              ],
              "minimum": -1000000000000,
              "maximum": 1000000000000
            }
          },
          "expected": {
            "type": [
              "number",
              "boolean"
            ],
            "minimum": -1000000000000,
            "maximum": 1000000000000
          },
          "type": {
            "enum": [
              "int"
            ]
          }
        }
      }
    }
  }
}
